<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:paddingTop="60dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="60dp" /> <TextView
            android:id="@+id/tvAddTitleHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yeni Bildirim Oluştur"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>


        <TextView android:text="Bildirim Türü" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etAddTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Başlık (Örn: Aydınlatma Sorunu)"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etAddDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Açıklama detayı..."
            android:inputType="textMultiLine"
            android:lines="3"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnGetLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konumumu Al"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <TextView
            android:id="@+id/tvLocationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konum henüz seçilmedi"
            android:textColor="#757575"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSaveNotification"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="BİLDİRİMİ GÖNDER"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>